<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring MVC endpoint 탐지는 취약점 판정이 아니라 외부 노출 지점의 수동 검토 알림이다.
         SecurityConfig에서 공개·인증·ADMIN 경로를 구분하고 컨트롤러 입력 검증을 확인했다. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT" />
        <Class name="~kr\.ac\.kopo\.ttd\.controller\..*" />
    </Match>

    <!-- 아래 생성자 매개변수는 Spring 컨테이너가 소유하는 singleton 의존성이다.
         애플리케이션 외부 호출자에게 mutable 참조를 노출하지 않는다. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2" />
        <Class name="~kr\.ac\.kopo\.ttd\.(ai\.AiClient|config\.(AdminAccountInitializer|DemoDataSeedInitializer|ProblemSeedInitializer|RestAccessDeniedHandler|RestAuthenticationEntryPoint)|grading\.GradingProducer|service\.(AttemptService|SubscriptionService))" />
        <Method name="&lt;init&gt;" />
    </Match>

    <!-- 데모 산점도·리더보드 데이터를 매번 동일하게 생성하기 위한 재현 가능 난수다.
         토큰·비밀번호·암호 키 등 보안 값 생성에는 사용하지 않는다. -->
    <Match>
        <Bug pattern="PREDICTABLE_RANDOM" />
        <Class name="kr.ac.kopo.ttd.config.DemoDataSeedInitializer" />
    </Match>

    <!-- Authorization 헤더는 신뢰하지 않고 JwtProvider의 서명·만료 검증을 통과한 claims만 사용한다. -->
    <Match>
        <Bug pattern="SERVLET_HEADER" />
        <Class name="kr.ac.kopo.ttd.config.JwtAuthenticationFilter" />
        <Method name="doFilterInternal" />
    </Match>

    <!-- 모든 동적 로그 값은 서버 생성 ID, 숫자, enum 또는 허용 목록의 모델명이다.
         요청 본문·사용자 메시지·PortOne 실패 사유 같은 자유 입력은 기록하지 않는다. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
        <Class name="kr.ac.kopo.ttd.ai.AiClient" />
        <Method name="call" />
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
        <Class name="kr.ac.kopo.ttd.config.DemoDataSeedInitializer" />
        <Method name="createUser" />
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
        <Class name="kr.ac.kopo.ttd.grading.GradingConsumer" />
        <Method name="~(lambda\$gradeInTransaction\$0|gradeWithRetry)" />
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
        <Class name="kr.ac.kopo.ttd.payment.PortOneClient" />
        <Method name="payWithBillingKey" />
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS" />
        <Class name="kr.ac.kopo.ttd.service.SubscriptionService" />
        <Method name="chargeSingleSubscription" />
    </Match>

    <!-- Spring Security DSL이 요구하는 시그니처이며 프레임워크 구성 단계에서만 호출된다. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION" />
        <Class name="kr.ac.kopo.ttd.config.SecurityConfig" />
        <Method name="securityFilterChain" />
    </Match>

    <!-- 내부 LLM 재시도에서 마지막 원인을 보존해 상위 consumer가 실패 상태로 전환하도록 하는 흐름이다. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
        <Class name="kr.ac.kopo.ttd.grading.GradingConsumer" />
        <Method name="gradeWithRetry" />
    </Match>
</FindBugsFilter>
