# EC2 배포 디렉터리(docker-compose.prod.yml과 같은 위치)에 .env로 복사해 실제 값을 채운다.
# 이 파일 자체(.env)는 절대 커밋하지 않는다.

# --- Postgres (RDS) ---
DB_HOST=
POSTGRES_DB=ttd
POSTGRES_USER=ttd
POSTGRES_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USERNAME=ttd
RABBITMQ_PASSWORD=

# --- 이미지 태그 (CD 워크플로우가 커밋 SHA로 덮어써서 pull) ---
IMAGE_TAG=latest

# --- 앱 시크릿 (README 참고: 반드시 운영용 값으로 교체) ---
AES_SECRET_KEY=
HMAC_SECRET_KEY=
JWT_SECRET_KEY=
OPENAI_API_KEY=

ADMIN_INIT_EMAIL=admin@ttd.local
ADMIN_INIT_PASSWORD=
ADMIN_INIT_NICKNAME=admin

CORS_ALLOWED_ORIGINS=https://example.com
AUTH_REFRESH_COOKIE_SAME_SITE=None

PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PAYMENT_MOCK_ENABLED=false

AI_MODEL=gpt-5.4-mini
AI_PREMIUM_CHAT_MODEL=gpt-5.4
AI_AVAILABLE_MODELS=gpt-5.4-mini,gpt-5.4,gpt-5.4-nano
